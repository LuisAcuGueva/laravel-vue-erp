# ==============================================================================
# Stage 1: Build Vue 3 Frontend
# ==============================================================================
FROM node:22-alpine AS front-builder

WORKDIR /app

# Copy package descriptors
COPY front-vue/package.json front-vue/package-lock.json* ./

# Copy frontend source files before install because postinstall script compiles icons
COPY front-vue ./

# Install dependencies and build
RUN npm install

# Pass build environment (defaulting to relative /api for unified reverse proxy)
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ==============================================================================
# Stage 2: Unified Production Nginx
# ==============================================================================
FROM nginx:alpine

WORKDIR /var/www/html

# Copy compiled Vue SPA assets
COPY --from=front-builder /app/dist /var/www/front

# Copy Laravel public folder
COPY back-laravel/public /var/www/html/public

# Copy custom Nginx configuration
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
